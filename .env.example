# 기본값: 공개 체인을 독립적으로 검증하고 보관하는 읽기 전용 follower.
TOMEI_NODE_ROLE=follower
TOMEI_PEERS=https://domeido.asuscomm.com/tomei

# 2026-09-07 공개 실험망 authority. 임의 피어의 키로 자동 교체하지 마세요.
TOMEI_AUTHORITY_PUBLIC_KEY=50b488f64c96f7a2eb212cfdd24369da553eed25b71db162307cc92fa45e102e
# 선택값: /network/info의 64자리 chain_id와 일치해야 합니다.
TOMEI_CHAIN_ID=aed090c182a18553bff094afab7ba0d61ab7b1c689fdd488b52d680677521980

# 호스트 외부 공개는 TLS reverse proxy를 권장합니다.
TOMEI_BIND_IP=127.0.0.1
TOMEI_PORT=8642
TOMEI_PUBLIC_URL=http://127.0.0.1:8642
TOMEI_SYNC_INTERVAL_MS=2000

# follower는 쓰기를 받지 않습니다. authority에서만 사용합니다.
TOMEI_WRITE_TOKEN=
