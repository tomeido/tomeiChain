# 새 독립 체인 생성용. 공개 네트워크 참여에는 .env.example을 사용하세요.
TOMEI_NODE_ROLE=authority
TOMEI_PEERS=
TOMEI_AUTHORITY_PUBLIC_KEY=
TOMEI_CHAIN_ID=
TOMEI_BIND_IP=127.0.0.1
TOMEI_PORT=8642
TOMEI_PUBLIC_URL=http://127.0.0.1:8642
TOMEI_BLOCK_INTERVAL_MS=2000
TOMEI_BATCH=100
# 외부에서 쓰기 API에 접근하게 하기 전에 충분히 긴 임의 토큰을 설정하세요.
TOMEI_WRITE_TOKEN=
